# Paste this into Streamlit Community Cloud: your app > Settings > Secrets.
# Never commit a real secrets.toml (it's in .gitignore).

ANTHROPIC_API_KEY = "sk-ant-..."     # a key from a workspace used only by this app
PUBLIC_MODE = "1"
FREE_QUESTIONS_PER_SESSION = "10"    # free questions per visitor session on your key
DAILY_QUESTION_CAP = "300"           # free questions per day across all visitors
ALLOW_VISITOR_KEYS = "1"             # visitors can paste their own key to keep going
MAX_FILE_MB = "10"
MAX_FILES = "5"
ALLOW_AUDIO = "0"
FILE_RETENTION_HOURS = "2"           # delete uploaded files after 2 hours (dedicated workspace only)
CLAUDE_MODEL = "claude-opus-5-5"
CLAUDE_EFFORT = "high"
