# Copy this file to .env and put your own key in it. Never commit .env.
# Create a key in the Claude Console: https://platform.claude.com
ANTHROPIC_API_KEY=your-api-key-here

# Optional. Uncomment to try the public-website behaviour locally.
# See DEPLOY.md for what each setting does.
# PUBLIC_MODE=1
# FREE_QUESTIONS_PER_SESSION=10
# DAILY_QUESTION_CAP=300
# ALLOW_VISITOR_KEYS=1
# MAX_FILE_MB=10
# MAX_FILES=5
# ALLOW_AUDIO=0
# FILE_RETENTION_HOURS=0
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
